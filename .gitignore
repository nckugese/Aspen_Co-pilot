# Leading slash matters: this ignores only the developer's own root-level client config.
# Without it the pattern also swallows plugin/.mcp.json, which every plugin install needs
# in order to have an MCP server at all.
/.mcp.json

# Local scratch files
Examples/
aspen-mcp/_test_*.py

