__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.env
*.bkp
# ...except the blank template, which is shipped inside the package and is what
# create_new_simulation copies. Without this negation the *.bkp rule above silently
# drops it from the repo and every install loses the ability to start a new simulation.
!Blank_Simulation.bkp
*.apw
venv/
.venv/

# Pinch analysis venv (recreate: see _SETUP_HINT in tools/pinch_tools.py)
.venv-pinch/
